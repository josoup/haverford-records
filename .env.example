# Postgres for the canonical store. Use a project SEPARATE from any other app.
DATABASE_URL=postgresql://localhost:5432/haverford_records

# Contact address advertised in the scraper User-Agent, so the athletics
# department can identify this traffic if they ever wonder about it.
SCRAPER_CONTACT=you@haverford.edu

# Seconds between requests to any one host. Do not lower without a reason.
SCRAPER_DELAY=2.0
